# LLM Configuration
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_PROVIDER=openai
MODEL_NAME=gpt-4-turbo-preview

# Agent Configuration
MAX_ITERATIONS=10
TEMPERATURE=0.1
MAX_TOKENS=4000
AGENT_VERBOSE=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/medical_agent

# Vector Database
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# External APIs
PUBMED_API_KEY=optional
PUBMED_EMAIL=your-email@example.com
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST

# Application
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
